@page "/"

<PageTitle>Home | ITMA</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.overline" Color="Color.Primary">Identity foundation</MudText>
        <MudText Typo="Typo.h3" GutterBottom="true">Build a secure workspace.</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            ITMA gives every account a secure, isolated workspace.
        </MudText>
    </div>

    <MudGrid>
        @foreach (var card in Cards)
        {
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.subtitle1">@card.Title</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@card.Description</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</MudStack>

@code {
    private static IReadOnlyList<FoundationCard> Cards { get; } =
    [
        new("Authentication", "Register with email verification and recover access safely."),
        new("Tenant workspace", "Each account starts in one isolated Owner workspace."),
        new("Audit history", "Review read-only security and administrative activity.")
    ];

    private sealed record FoundationCard(string Title, string Description);
}
