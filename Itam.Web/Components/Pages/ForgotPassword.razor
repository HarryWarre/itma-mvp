@page "/account/forgot-password"
@attribute [AllowAnonymous]

<PageTitle>Forgot password | ITMA</PageTitle>

<MudPaper Class="pa-6 mx-auto" MaxWidth="MaxWidth.Small">
    <MudText Typo="Typo.h4" GutterBottom="true">Reset your password</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        If the account exists and is confirmed, you will receive reset instructions.
    </MudText>
    <form method="post" action="/account/forgot-password">
        <AntiforgeryToken />
        <label class="d-block mb-3">Email<input class="mud-input-root mud-input-root-text mud-input-outlined" type="email" name="Email" autocomplete="email" required /></label>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Send reset link</MudButton>
    </form>
</MudPaper>
