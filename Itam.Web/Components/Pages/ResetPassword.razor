@page "/account/reset-password"
@attribute [AllowAnonymous]

<PageTitle>Reset password | ITMA</PageTitle>

<MudPaper Class="pa-6 mx-auto" MaxWidth="MaxWidth.Small">
    <MudText Typo="Typo.h4" GutterBottom="true">Choose a new password</MudText>
    @if (Error == "invalid")
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">This reset link is invalid or expired.</MudAlert>
    }
    <form method="post" action="/api/account/reset-password">
        <AntiforgeryToken />
        <input type="hidden" name="UserId" value="@UserId" />
        <input type="hidden" name="Token" value="@Token" />
        <label class="d-block mb-3">New password<input class="mud-input-root mud-input-root-text mud-input-outlined" type="password" name="Password" autocomplete="new-password" required /></label>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Reset password</MudButton>
    </form>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }
}
